# Foundry Configuration (using Azure Identity - no API key needed)
AZURE_OPENAI_ENDPOINT=https://foundry-workshop-[yourname].cognitiveservices.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini  # Alternatives: gpt-4.1, gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small  # Alternative: text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Foundry Project Configuration (will be added in Sub-Lab 1.4)
# Get endpoint via CLI: az cognitiveservices account project show --name foundry-workshop-[yourname] --resource-group rg-foundry-workshop-[yourname] --project-name my-first-chatbot --query "properties.endpoints.\"AI Foundry API\"" -o tsv
AZURE_AI_PROJECT_ENDPOINT=https://foundry-workshop-[yourname].services.ai.azure.com/api/projects/my-first-chatbot

# Get resource ID via CLI: az cognitiveservices account project show --name foundry-workshop-[yourname] --resource-group rg-foundry-workshop-[yourname] --project-name my-first-chatbot --query "id" -o tsv
AZURE_AI_PROJECT_RESOURCE_ID=/subscriptions/[your-subscription-id]/resourceGroups/rg-foundry-workshop-[yourname]/providers/Microsoft.CognitiveServices/accounts/foundry-workshop-[yourname]/projects/my-first-chatbot

# Azure AI Search Configuration (will be added in Sub-Lab 1.3)
AZURE_SEARCH_ENDPOINT=https://search-chatbot-[yourname].search.windows.net
AZURE_SEARCH_INDEX_NAME=chatbot-knowledge-base

# Azure Resource Group (must match your actual resource group name)
AZURE_RESOURCE_GROUP=rg-foundry-workshop-[yourname]

# Foundry IQ Knowledge Base Configuration (will be added in Sub-Lab 1.4)
KNOWLEDGE_BASE_NAME=techcorp-kb
KNOWLEDGE_SOURCE_NAME=techcorp-docs
MCP_CONNECTION_NAME=kb-mcp-connection

# Azure Storage Configuration (will be added in Sub-Lab 1.2)
AZURE_STORAGE_ACCOUNT_NAME=stchatbot[yourname]
AZURE_STORAGE_CONTAINER_NAME=knowledge-base-container

# GPT Realtime Configuration (will be added in Sub-Lab 2.2)
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_REALTIME_VOICE=shimmer  # Options: alloy, ash, coral, echo, sage, shimmer
